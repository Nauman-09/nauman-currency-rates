{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nauman/currency-converter",
	"version": "2.0.0",
	"title": "Currency Calculator",
	"category": "widgets",
	"icon": "calculator",
	"description": "Visitors pick a currency, type an amount, and see the value in your target currency.",
	"keywords": [ "currency", "converter", "calculator", "exchange" ],
	"textdomain": "nauman-currency-rates",
	"attributes": {
		"target": { "type": "string", "default": "PKR" },
		"symbols": {
			"type": "array",
			"items": { "type": "string" },
			"default": [ "USD", "EUR", "GBP", "AED", "SAR" ]
		},
		"amount": { "type": "number", "default": 100 },
		"label": { "type": "string", "default": "Amount you want to exchange" }
	},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js"
}
